source "https://rubygems.org"

# GitHub Pages uses Jekyll 3.10. Keep the local toolchain aligned, without
# downloading the legacy theme bundle and its unused dependencies.
gem "jekyll", "~> 3.10.0"
gem "webrick", "~> 1.8"
gem "csv", "~> 3.3"
gem "kramdown-parser-gfm", "~> 1.1"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-sitemap", "~> 1.4"
  gem "jekyll-redirect-from", "~> 0.16"
  gem "jekyll-paginate", "~> 1.1"
  gem "jekyll-gist", "~> 1.5"
end
